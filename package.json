{
  "name": "ad-marketplace",
  "private": true,
  "scripts": {
    "dev:app": "pnpm --filter @ad-marketplace/app dev",
    "dev:backend": "pnpm --filter @ad-marketplace/backend dev",
    "build:app": "pnpm --filter @ad-marketplace/app build",
    "build:backend": "pnpm --filter @ad-marketplace/backend build",
    "anchor:build:localnet": "anchor build && pnpm sync:anchor-idl",
    "anchor:deploy:localnet": "anchor program deploy --provider.cluster localnet --commitment processed -- --use-rpc --commitment processed",
    "sync:anchor-idl": "node scripts/sync-anchor-idl.mjs",
    "test:backend": "pnpm --filter @ad-marketplace/backend test",
    "test": "pnpm exec ts-mocha -p ./tsconfig.json -t 1000000 \"tests/**/*.ts\"",
    "lint": "prettier \"{tests,app,backend}/**/*.{ts,tsx,js,jsx,json,css,html,md,yaml,yml}\" README.md package.json pnpm-workspace.yaml --ignore-path .gitignore --check",
    "lint:fix": "prettier \"{tests,app,backend}/**/*.{ts,tsx,js,jsx,json,css,html,md,yaml,yml}\" README.md package.json pnpm-workspace.yaml --ignore-path .gitignore --write"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.1.2",
    "@solana/web3.js": "1.99.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "prettier": "^3.0.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
